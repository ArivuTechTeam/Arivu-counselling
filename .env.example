# ---------------------------------------------------------------------------
# Root env for docker-compose — TEMPLATE
# Copy to `.env` in this same folder (gitignored — see .gitignore's
# `.env` / `.env.*` rules) and fill in real values. docker-compose.yml reads
# these via ${VAR} interpolation for both the backend and frontend builds.
#
# Same underlying values as backend/.env.example and
# frontend/.env.local.example — duplicated here only because Compose reads
# from the root .env, not from those subfolder files.
# ---------------------------------------------------------------------------

# --- Supabase (one project, used by both services) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# --- AI / LLM ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Per-user AI rate limits (rolling one-hour window) ---
# Maximum standard quiz generations per user per hour.
RATE_LIMIT_QUIZ_GENERATION_PER_HOUR=10
# Maximum blueprint quiz generations per user per hour.
RATE_LIMIT_BLUEPRINT_PER_HOUR=10
# Maximum document topic extractions per user per hour.
RATE_LIMIT_TOPIC_EXTRACTION_PER_HOUR=10
# Maximum question regenerations per user per hour.
RATE_LIMIT_QUESTION_REGENERATE_PER_HOUR=10
# Maximum question explanations per user per hour.
RATE_LIMIT_QUESTION_EXPLAIN_PER_HOUR=10

# --- Student quiz policy ---
# Maximum starts per student for the same published quiz variant.
STUDENT_QUIZ_ATTEMPT_LIMIT=2
# IANA timezone controlling Daily Challenge reset and streak dates.
DAILY_CHALLENGE_TIMEZONE=Asia/Kolkata
CHALLENGE_EXPIRY_DAYS=30
