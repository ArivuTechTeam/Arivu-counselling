# ---------------------------------------------------------------------------
# Root env for docker-compose — TEMPLATE
# Copy to `.env` in this same folder (gitignored — see .gitignore's
# `.env` / `.env.*` rules) and fill in real values. docker-compose.yml reads
# these via ${VAR} interpolation for both the backend and frontend builds.
#
# Same underlying values as backend/.env.example and
# frontend/.env.local.example — duplicated here only because Compose reads
# from the root .env, not from those subfolder files.
# ---------------------------------------------------------------------------

# --- Supabase (one project, used by both services) ---
# Debug is opt-in and may only be enabled with a localhost frontend origin.
APP_ENV=development
APP_DEBUG=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key
SUPABASE_JWT_SECRET=replace_with_your_supabase_jwt_signing_secret
SUPABASE_READ_TIMEOUT_SECONDS=5

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key
NEXT_PUBLIC_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
# Optional local-development account labels/emails. Never put passwords here.
NEXT_PUBLIC_DEV_ACCOUNT_EMAILS_JSON=[]

# Exact browser origin accepted by the backend in non-Docker deployments.
FRONTEND_ORIGIN=http://localhost:3001

# --- AI / LLM ---
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_STRUCTURED_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=240
DEEPSEEK_MAX_OUTPUT_TOKENS=65536
AI_FALLBACK_PROVIDER=gemini
TOPIC_ANALYSIS_PROVIDER=deepseek
QUIZ_GENERATION_PROVIDER=deepseek
TYPED_QUIZ_EXTRACTION_PROVIDER=deepseek
QUESTION_VERIFICATION_PROVIDER=deepseek
QUESTION_REGENERATION_PROVIDER=deepseek
VISION_EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_BLUEPRINT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_TIMEOUT_SECONDS=240
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=65536
EXTRACTION_TEXT_CHUNK_CHARS=18000
EXTRACTION_CHUNK_CONCURRENCY=4
GENERATION_MAX_TEXT_CHARS=100000

# --- Large-document Map-Reduce generation ---
# Extracted text above this character count uses the background chunked path.
CHUNKING_TRIGGER_CHARS=100000
# Target primary characters per chunk and approximate character overlap.
GENERATION_CHUNK_CHARS=60000
GENERATION_CHUNK_OVERLAP_CHARS=5000
# Avoid emitting a very small final chunk by merging it into its predecessor.
GENERATION_CHUNK_MIN_CHARS=8000
# Maximum chunk extraction calls running concurrently for one document.
GENERATION_CHUNK_CONCURRENCY=4
# Maximum output tokens for large map/reduce JSON responses.
GENERATION_MAP_MAX_OUTPUT_TOKENS=65536
# Maximum leading document characters used by the best-effort profile call.
GENERATION_PROFILE_MAX_CHARS=200000

# --- Per-user AI rate limits (rolling one-hour window) ---
# Maximum standard quiz generations per user per hour.
RATE_LIMIT_QUIZ_GENERATION_PER_HOUR=10
# Maximum blueprint quiz generations per user per hour.
RATE_LIMIT_BLUEPRINT_PER_HOUR=10
# Maximum document topic extractions per user per hour.
RATE_LIMIT_TOPIC_EXTRACTION_PER_HOUR=30
GENERATION_LARGE_REQUEST_TIMEOUT_SECONDS=600
GENERATION_CHUNK_STUCK_SECONDS=900
# Maximum question regenerations per user per hour.
RATE_LIMIT_QUESTION_REGENERATE_PER_HOUR=10
# Maximum question explanations per user per hour.
RATE_LIMIT_QUESTION_EXPLAIN_PER_HOUR=10
# Maximum existing-quiz document extractions per user per hour.
RATE_LIMIT_QUIZ_EXTRACTION_PER_HOUR=10
RATE_LIMIT_CHALLENGE_JOIN_PER_HOUR=30

# --- Student quiz policy ---
# Maximum starts per student for the same published quiz variant.
STUDENT_QUIZ_ATTEMPT_LIMIT=2
# IANA timezone controlling Daily Challenge reset and streak dates.
DAILY_CHALLENGE_TIMEZONE=Asia/Kolkata
CHALLENGE_EXPIRY_DAYS=30

# Optional development seed-script input. This value is personal data; use a
# disposable development account and never print it in logs.
SEED_STUDENT_EMAIL=student@example.invalid
# Enable only after applying the additive faculty-job SQL and starting the worker.
FACULTY_JOBS_ENABLED=false
