# ---------------------------------------------------------------------------
# Frontend environment variables — TEMPLATE
# Copy to `.env.local` (gitignored) and fill in real values.
#
# ONLY variables prefixed NEXT_PUBLIC_ are exposed to the browser. That is
# intentional here: the URL and anon key are safe to ship to the client.
# NEVER put the service_role key in this file — it must stay backend-only.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key. Respects Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# Base URL of the FastAPI backend. Locally this is 8001, not FastAPI/uvicorn's
# default 8000 — 8000 is used by a different project (arivupro_examapp) on
# this machine. Match whatever port you actually start uvicorn on.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Optional, local dev only. JSON array of test-account labels and emails for
# components/shared/dev-account-switcher.tsx (hidden in production builds).
# This is public browser configuration: NEVER add passwords. Example:
# NEXT_PUBLIC_DEV_ACCOUNT_EMAILS_JSON=[{"label":"Teacher","role":"teacher","email":"you@example.com"}]
NEXT_PUBLIC_DEV_ACCOUNT_EMAILS_JSON=[]
