# ---------------------------------------------------------------------------
# Backend environment variables — TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same folder and fill in the real values:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows cmd)
# The real `.env` is gitignored and must NEVER be committed.
#
# Where to find these in Supabase:
#   Project Settings -> API   (URL + anon + service_role keys)
#   Project Settings -> API -> JWT Settings   (JWT secret)
# ---------------------------------------------------------------------------

# Your project's base URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public "anon" key. Respects Row Level Security. Safe to also use in frontend.
SUPABASE_ANON_KEY=

# SECRET "service_role" key. Bypasses Row Level Security. BACKEND ONLY.
# If this ever leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The secret Supabase signs its JWTs with. Used to verify tokens locally.
SUPABASE_JWT_SECRET=

# Exact frontend origin allowed to call this API from the browser (CORS).
# Production must be the real Vercel URL. Localhost CORS and API docs are
# enabled only when this value's hostname is localhost or 127.0.0.1.
FRONTEND_ORIGIN=http://localhost:3000

# --- AI / LLM (Slice 3) ---
# DeepSeek API key (primary quiz-generation model). Required for generation.
DEEPSEEK_API_KEY=
# Optional overrides (defaults shown):
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Gemini (Google) — if set, becomes the PRIMARY model (DeepSeek is the fallback).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Timeout for Gemini vision when extracting scanned PDFs/images (seconds).
GEMINI_VISION_TIMEOUT_SECONDS=240
# Maximum Gemini output tokens available to one vision-extraction response.
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=65536
# Maximum characters sent in each typed-document extraction chunk.
EXTRACTION_TEXT_CHUNK_CHARS=18000
# Maximum typed-document chunks processed concurrently per extraction request.
EXTRACTION_CHUNK_CONCURRENCY=4

# --- Per-user AI rate limits (rolling one-hour window) ---
# Maximum standard quiz generations per user per hour.
RATE_LIMIT_QUIZ_GENERATION_PER_HOUR=10
# Maximum blueprint quiz generations per user per hour.
RATE_LIMIT_BLUEPRINT_PER_HOUR=10
# Maximum document topic extractions per user per hour.
RATE_LIMIT_TOPIC_EXTRACTION_PER_HOUR=10
# Maximum question regenerations per user per hour.
RATE_LIMIT_QUESTION_REGENERATE_PER_HOUR=10
# Maximum question explanations per user per hour.
RATE_LIMIT_QUESTION_EXPLAIN_PER_HOUR=10
# Maximum existing-quiz document extractions per user per hour.
RATE_LIMIT_QUIZ_EXTRACTION_PER_HOUR=10
