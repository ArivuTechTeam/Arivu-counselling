# ---------------------------------------------------------------------------
# Backend environment variables — TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same folder and fill in the real values:
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows cmd)
# The real `.env` is gitignored and must NEVER be committed.
#
# Where to find these in Supabase:
#   Project Settings -> API   (URL + anon + service_role keys)
#   Project Settings -> API -> JWT Settings   (JWT secret)
# ---------------------------------------------------------------------------

# Debug is OFF by default. Set true only for localhost development to expose
# FastAPI's /docs and /openapi.json endpoints.
APP_ENV=development
APP_DEBUG=false

# Your project's base URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Public "anon" key. Respects Row Level Security. Safe to also use in frontend.
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_key

# SECRET "service_role" key. Bypasses Row Level Security. BACKEND ONLY.
# If this ever leaks, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# The secret Supabase signs its JWTs with. Used to verify tokens locally.
SUPABASE_JWT_SECRET=replace_with_your_supabase_jwt_signing_secret

# Per-attempt timeout for idempotent Data API reads. Keep below the frontend's
# ordinary 20-second timeout so bounded backend retries can finish first.
SUPABASE_READ_TIMEOUT_SECONDS=5

# Exact frontend origin allowed to call this API from the browser (CORS).
# Production must be the real Vercel URL. Localhost CORS and API docs are
# enabled only when this value's hostname is localhost or 127.0.0.1.
FRONTEND_ORIGIN=http://localhost:3001

# --- AI / LLM (Slice 3) ---
# DeepSeek handles text analysis/generation by default. At least one of
# DEEPSEEK_API_KEY / GEMINI_API_KEY is required; missing preferred credentials
# are skipped safely and the configured fallback is used.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Optional overrides (defaults shown):
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_STRUCTURED_MAX_OUTPUT_TOKENS=16384
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=240
# Manual accounting conversion used by API-call cost reporting; keep current.
USD_TO_INR_RATE=83.0
# Maximum output tokens for the large-JSON fallback path.
DEEPSEEK_MAX_OUTPUT_TOKENS=65536

# Stage-aware provider routing. Keep Gemini for image/scanned-document vision.
AI_FALLBACK_PROVIDER=gemini
TOPIC_ANALYSIS_PROVIDER=deepseek
QUIZ_GENERATION_PROVIDER=deepseek
TYPED_QUIZ_EXTRACTION_PROVIDER=deepseek
QUESTION_VERIFICATION_PROVIDER=deepseek
QUESTION_REGENERATION_PROVIDER=deepseek
VISION_EXTRACTION_PROVIDER=gemini

# Gemini (Google) — vision provider and controlled text fallback.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
# Used when GEMINI_MODEL returns model-not-found (404), before provider fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Used by direct Gemini structured calls and retained for compatibility.
GEMINI_BLUEPRINT_MODEL=gemini-3.5-flash-lite

# Timeout for Gemini vision when extracting scanned PDFs/images (seconds).
GEMINI_VISION_TIMEOUT_SECONDS=240
# Maximum Gemini output tokens available to one vision-extraction response.
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=65536
# Maximum characters sent in each typed-document extraction chunk.
EXTRACTION_TEXT_CHUNK_CHARS=18000
# Maximum typed-document chunks processed concurrently per extraction request.
EXTRACTION_CHUNK_CONCURRENCY=4

# Maximum document text passed to one single-call quiz-generation request.
GENERATION_MAX_TEXT_CHARS=100000

# --- Large-document Map-Reduce generation ---
# Extracted text above this character count uses the background chunked path.
CHUNKING_TRIGGER_CHARS=100000
# Target primary characters per chunk and approximate character overlap.
GENERATION_CHUNK_CHARS=60000
GENERATION_CHUNK_OVERLAP_CHARS=5000
# Avoid emitting a very small final chunk by merging it into its predecessor.
GENERATION_CHUNK_MIN_CHARS=8000
# Maximum chunk extraction calls running concurrently for one document.
GENERATION_CHUNK_CONCURRENCY=4
# Maximum output tokens for large map/reduce JSON responses.
GENERATION_MAP_MAX_OUTPUT_TOKENS=65536
# Timeout for large MAP/REDUCE provider calls. A 300-page consolidation can
# exceed the shorter interactive request timeout.
GENERATION_LARGE_REQUEST_TIMEOUT_SECONDS=600
# Maximum leading document characters used by the best-effort profile call.
GENERATION_PROFILE_MAX_CHARS=200000
# Running jobs older than this are marked failed when their status is polled.
# Must remain longer than GENERATION_LARGE_REQUEST_TIMEOUT_SECONDS so polling
# does not mark an active consolidation as failed.
GENERATION_CHUNK_STUCK_SECONDS=900

# --- Per-user AI rate limits (rolling one-hour window) ---
# Maximum standard quiz generations per user per hour.
RATE_LIMIT_QUIZ_GENERATION_PER_HOUR=10
# Maximum blueprint quiz generations per user per hour.
RATE_LIMIT_BLUEPRINT_PER_HOUR=10
# Maximum document-analysis AI calls per user per hour. One large document uses
# one profile call, one call per chunk, and one or two consolidation attempts.
RATE_LIMIT_TOPIC_EXTRACTION_PER_HOUR=30
# Maximum question regenerations per user per hour.
RATE_LIMIT_QUESTION_REGENERATE_PER_HOUR=10
# Maximum question explanations per user per hour.
RATE_LIMIT_QUESTION_EXPLAIN_PER_HOUR=10
# Maximum existing-quiz document extractions per user per hour.
RATE_LIMIT_QUIZ_EXTRACTION_PER_HOUR=10
# Maximum friend-challenge code lookups per student per hour.
RATE_LIMIT_CHALLENGE_JOIN_PER_HOUR=30

# --- Student quiz policy ---
# Maximum starts allowed per student for the same published quiz variant.
# Restart the backend after changing this value.
STUDENT_QUIZ_ATTEMPT_LIMIT=2
# IANA timezone controlling Daily Challenge reset and streak dates.
# Restart the backend after changing this value.
DAILY_CHALLENGE_TIMEZONE=Asia/Kolkata
CHALLENGE_EXPIRY_DAYS=30

# Optional development seed-script input. Use only a disposable account; the
# script deliberately never prints this personal value.
SEED_STUDENT_EMAIL=student@example.invalid
# Enable only after applying the additive faculty-job SQL and starting the worker.
# Deployment-wide emergency switches. In the commerce product, a feature is
# available to every institution whenever its switch is true.
FACULTY_JOBS_ENABLED=false
FACULTY_JOBS_POLL_SECONDS=3

# Optional extended objective types (assertion_reason, mrm, matching).
# Enable only after migration 61 and a coordinated API/worker rollout.
# Read by app/lib/config.py at process startup; restart the backend afterward.
EXTENDED_QUESTION_TYPES_ENABLED=false

# Optional review/publishing tools. Keep disabled until the matching API and
# frontend are deployed together. Blueprint publishing also requires
# QUIZ_REUSE_ENABLED so it can use atomic release locking/publication.
REJECTED_PURGE_ENABLED=false
EXTRACTION_BLUEPRINT_ENABLED=false
REGENERATE_SET_ENABLED=false
REGENERATE_SET_MAX_QUESTIONS=40
REGENERATE_SET_CONCURRENCY=5

# Optional paper bank (PYQ/MTP/RTP). Keep off until migrations 63-65 are applied,
# and the API and worker are released together and tested. PYQ_ENABLED is only
# a legacy alias; use PAPER_BANK_ENABLED for new deployments.
PAPER_BANK_ENABLED=false
# Per-student rolling-hour cap for paid descriptive paper grading.
RATE_LIMIT_PAPER_GRADING_PER_HOUR=10

# Enable after migration 51 and deployment of matching API/frontend.
QUIZ_REUSE_ENABLED=false
# Enable after migrations 52-53. Batch access is course-and-level scoped.
BATCHES_ENABLED=false
# Enable after migrations 54-55.
SCORING_POLICIES_ENABLED=false
# Enable after migration 56 and after paper profiles have been configured.
COMMERCE_PACK_ENABLED=false
# Enable after migrations 49-50 and creation of the private figure bucket.
FIGURE_ATTACH_ENABLED=false
FIGURE_MAX_PER_DOCUMENT=50
# Worker monitoring.
FACULTY_WORKER_STALE_SECONDS=120
